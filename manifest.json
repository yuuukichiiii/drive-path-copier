{
  "manifest_version": 3,
  "name": "Drive Path Copier",
  "version": "1.1",
  "description": "Google DriveのフォルダパスをWindowsパス形式（G:\\...）でクリップボードにコピーします",
  "key": "",
  "permissions": ["identity", "activeTab", "storage", "clipboardWrite"],
  "oauth2": {
    "client_id": "371002347219-8b76bgeq595qn0tpoh8d5asehd50i5au.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.readonly",
      "https://www.googleapis.com/auth/userinfo.email"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Drive Path Copy",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png"
    }
  }
}
